# --- Google Gemini (required) ---------------------------------------------
# Server-only key for the real generateContent call. Never expose to the client.
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides. Defaults: gemini-3.5-flash-lite, falling back to
# gemini-3.1-flash-lite (each has its own free-tier quota). Pinned versions:
# the gemini-flash-latest alias moves with every release.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Asked first for the OpenStreetMap names of places not found, so repair usually
# spends this model's quota, not the primary's; gemini-3.5-flash-lite answers if
# it is slow or down.
# GEMINI_REPAIR_MODEL=gemini-3.1-flash-lite

# --- Upstash Redis (optional: shared cache, Nominatim slot, rate limits) -----
# Free tier is plenty. Without it, caching and rate limits are per instance.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Rate limits for /api/plan (production only). Defaults shown.
# PLAN_RATE_PER_HOUR=5
# PLAN_DAILY_CAP=350

# --- OpenStreetMap -------------------------------------------------------------
# Optional: another Nominatim search endpoint (the usage policy asks apps to be
# able to switch). Defaults to the public server.
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# --- NVIDIA draft panel (optional, experimental) --------------------------
# NVIDIA's API trial terms allow testing and evaluation only, not production,
# and the default panel models' free endpoints were retired in 2026. If absent,
# Wanderlore runs the single-Gemini path.
# NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_PANEL_MODELS=mistralai/mistral-large-3-675b-instruct-2512,openai/gpt-oss-120b
# PANEL_TIMEOUT_MS=14000
# PANEL_MIN_QUORUM=1

# --- Supabase (optional: enables saving + shareable trip links) -----------
# Locally, copy these from Supabase -> Project Settings -> API. If absent, the
# app still generates trips; only save/share is disabled.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
